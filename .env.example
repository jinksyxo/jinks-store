ADMIN_PASSWORD=matsumoto-dev
SESSION_SECRET=replace-with-a-long-random-string
# Optional. Leave blank to keep admin login password-only. Generate one with
# `npm run setup-2fa`.
ADMIN_TOTP_SECRET=
PORT=3001
APP_URL=http://localhost:5173
STRIPE_SECRET_KEY=sk_test_replace_me
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_ALLOWED_SHIPPING_COUNTRIES=US
STRIPE_STANDARD_SHIPPING_AMOUNT=800
STRIPE_FREE_SHIPPING_THRESHOLD=6500
STRIPE_TAX_BEHAVIOR=exclusive
# Optional. Leave blank to use the default tax code from Stripe Tax settings.
STRIPE_DEFAULT_TAX_CODE=
# Leave these blank to keep using the local SQLite store.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Shipping spreadsheets (Mon/Wed/Fri) — sent via Resend (resend.com).
# Leave RESEND_API_KEY blank to skip email and still generate spreadsheets.
RESEND_API_KEY=
# Must be a sender your Resend account can send from. onboarding@resend.dev
# works before you verify your own domain.
RESEND_FROM_EMAIL=onboarding@resend.dev
SHIPPING_SPREADSHEET_ALERT_EMAIL=jinks@matsumotoshop.com
SHIPPING_SPREADSHEET_TIMEZONE=America/Denver
SHIPPING_SPREADSHEET_HOUR=7
# "Ship from" info printed on every row of the shipping spreadsheet.
SHIPPING_FROM_NAME=Ethan Jinks
SHIPPING_FROM_ADDRESS=1233 W Trimble Ln, West Jordan Utah, 84088-9082
